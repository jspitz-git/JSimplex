+++ b/src/legacy_primal_point.jl
@@ -134,0 +135,25 @@ end
+# Adjust only an immediate representable neighbor of a violating basic value.
+# This mutates a correction trial; its caller owns rollback and must still
+# certify the complete point, since even one ULP can change a row substantially.
+function _round_primal_bound_trial_inward!(workspace::SimplexWorkspace{T}) where {T<:Union{Float32,Float64}}
+    tolerance = workspace.options.primal_tolerance
+    changed = false
+    for index in workspace.basis.basic_indices
+        value = workspace.primal[index]
+        isfinite(value) || return false
+        inward = if _lower_violation(workspace.lower[index], value) > tolerance
+            nextfloat(value)
+        elseif _upper_violation(workspace.upper[index], value) > tolerance
+            prevfloat(value)
+        else
+            continue
+        end
+        isfinite(inward) &&
+            max(_lower_violation(workspace.lower[index], inward),
+                _upper_violation(workspace.upper[index], inward)) <= tolerance || return false
+        workspace.primal[index] = inward
+        changed = true
+    end
+    return changed
+end
+
@@ -165,0 +191 @@ function _try_native_primal_point_correction!(workspace::SimplexWorkspace{T}, st
+    rounded = false
@@ -170 +196,5 @@ function _try_native_primal_point_correction!(workspace::SimplexWorkspace{T}, st
-        _legacy_primal_point_certified(workspace) || return false
+        if !_legacy_primal_point_certified(workspace)
+            _round_primal_bound_trial_inward!(workspace) || return false
+            _legacy_primal_point_certified(workspace) || return false
+            rounded = true
+        end
@@ -185,0 +216 @@ function _try_native_primal_point_correction!(workspace::SimplexWorkspace{T}, st
+    rounded && _simplex_event!(workspace, :primal_bound_roundoff_corrected)
