# MA-R fixed prospective fixtures. UNEXECUTED. No post-output selection.
version = 1
bits = [128, 256, 512]
sizes = [0, 1, 2, 8, 15, 16, 32, 64]
layouts = ["dense", "zeroheavy"]
directions = ["forward", "transpose"]
# Index i,j are one-based; all coefficients constructed via exact rational values.
diagonal = "n+2+i/16"
offdiagonal = "(-1)^(i+j)*(1+mod(3*i+5*j,7))/64"
zeroheavy_support = "abs(i-j)==1 || (i==n && j==1)"
rhs = "(-1)^i*(1+i/16)"
empty = "0x0 LU and length0 vectors"
singleton = "diagonal formula and RHS formula"
special_size = 16
special_bits = 256
specials = ["identity", "row_swap", "cancellation", "signed_zero", "rhs_inf", "rhs_nan", "factor_inf", "factor_nan", "pivot_zero_1", "pivot_zero_8", "pivot_zero_16", "invalid_ipiv", "rhs_short", "dest_long", "rhs_view", "same_container", "shared_leaves", "factor_rhs_leaf", "copied_pfi", "retained_outputs"]
# Each special runs forward and transpose, with fixed literal alterations in tests.jl.
mixed_stored_ambient = [[128,256], [512,256], [256,128], [256,512]]
matching_rounding = ["RoundNearest", "RoundDown", "RoundUp", "RoundToZero"]
scoped_mismatch = ["RoundUp", "RoundDown"]
# Three sides per correctness case: original, uninstrumented candidate, instrumented.
# All retain identical owner graphs by deep-copying one constructed bundle.

