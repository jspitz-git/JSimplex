@noinline timer_empty()=nothing
function generated_code(out,records)
    for (name,tag) in (("old",Val(:old)),("new",Val(:new)))
        io=IOBuffer();code_llvm(io,microbatch,Tuple{typeof(tag)};raw=true,dump_module=false,optimize=true,debuginfo=:none)
        s=String(take!(io));path=joinpath(out,"micro-$name.ll")
        ispath(path) && error("LLVM output exists");write(path,s)
        calls=[m.match for m in eachmatch(r"(?m)^.*\b(?:call|invoke)\b[^\n]*@j_probe_[^\n]*$",s)]
        # Fail closed on hoisting, inlining, generic apply/indirect call, or rerolling.
        good=sizeof(s)<=1048576 && length(calls)==256 && !occursin(r"\b(?:call|invoke)\b[^\n]*\b(?:jl_apply|ijl_apply|jl_invoke|ijl_invoke)\b",s) && !occursin(r"\b(?:call|invoke)\b[^@\n]*%[A-Za-z0-9_.]+\(",s)
        push!(records,Dict("arm"=>name,"path"=>path,"probe_calls"=>length(calls),"accepted"=>good,"ir_bytes"=>sizeof(s)))
        io=IOBuffer();code_llvm(io,probe,Tuple{typeof(tag)};raw=true,dump_module=false,optimize=true,debuginfo=:none)
        body=String(take!(io));bodypath=joinpath(out,"probe-$name.ll")
        ispath(bodypath) && error("probe output exists");write(bodypath,body)
        records[end]["probe_path"]=bodypath;records[end]["probe_ir_bytes"]=sizeof(body)
        good && 0<sizeof(body)<=1048576 || error("micro code boundary not proven; stop without tuning")
    end
    records
end
function microwindow(tag::T) where T
    t=@timed microbatch(tag)
    return metrics(t),t.value
end
function micros(index,rows,progress)
    for (ci,scope) in enumerate(MICRO)
        context(scope) do
            expected=scope in ("absent","keys8","equal") ? 256 : 0
            ws=Any[]
            push!(rows,Dict("id"=>scope,"expected"=>expected,"windows"=>ws))
            for pair in 1:10
                order=iseven(index+ci+pair) ? (1,2) : (2,1)
                for (oi,side) in enumerate(order)
                    tag=side==1 ? Val(:old) : Val(:new)
                    progress["location"]="micro/$scope/$pair/$side"
                    w,value=microwindow(tag)
                    merge!(w,Dict("side"=>side==1 ? "reference" : "candidate","pair"=>pair,"order"=>oi,"phase"=>pair<=3 ? "warm" : "measured","calls"=>256,"checksum"=>value))
                    push!(ws,w)
                    journal_record(Dict("kind"=>"micro","location"=>progress["location"],"window"=>copy(w)))
                    value==expected || error("micro checksum")
                end
            end
        end
    end
    rows
end
function canonical(s)
    for (mode,label) in zip(G.MODES,("RoundNearest","RoundDown","RoundUp","RoundToZero","RoundFromZero"))
        s=replace(s,string(mode)=>label)
    end
    return s
end
function qualify()
    r=Ref{Any}();ts=@testset "MA-V exact MA-U qualification" begin
        r[]=G.qualification()
    end
    x=r[]
    pred(r)=Dict("id"=>canonical(r.id),"reference"=>r.reference,"candidate"=>r.candidate,"expected"=>r.expected,"effective"=>canonical(r.effective))
    Dict("counts"=>counts(ts),"predicates"=>[pred(r) for r in x.predicates],"transitions"=>[pred(r) for r in x.transitions.records],"tasks_created"=>x.transitions.tasks_created,
        "no_scope_available"=>x.transitions.no_scope.available,"no_scope_records"=>x.transitions.no_scope.available ? [pred(x.transitions.no_scope.record)] : Any[],
        "whole"=>[Dict("id"=>canonical(r.id),"direction"=>r.direction,"eligible"=>r.eligible,"calls_per_side"=>r.calls_per_side,"exception"=>r.exception===nothing ? String[] : collect(r.exception),"output"=>[repr(v) for v in r.output],"route_counts"=>Dict(string(k)=>v for (k,v) in pairs(r.route_counts))) for r in x.whole])
end
function partialvalue(x)
    x isa NamedTuple && return Dict(string(k)=>partialvalue(v) for (k,v) in pairs(x))
    x isa AbstractDict && return Dict(string(k)=>partialvalue(v) for (k,v) in x)
    x isa AbstractArray && return [partialvalue(v) for v in x]
    x === nothing && return "nothing"
    x isa Bool && return x
    x isa Int && return x
    x isa String && return canonical(x)
    return repr(x)
end
