        started=time_ns();costs(index,COSTS,raw["costs"],raw["progress"]);raw["cost_inclusive_seconds"]=(time_ns()-started)/1e9
        all(w["compile_seconds"]==0 && w["recompile_seconds"]==0 for key in ("costs","micro","red") for c in raw[key] for w in c["windows"] if w["phase"]=="measured") || error("measured compilation")
    catch e
        push!(raw["errors"],sprint(showerror,e,catch_backtrace()))
    finally
        G.JOURNAL_HOOK[]=nothing
        JOURNAL[]===nothing || (close(JOURNAL[]);JOURNAL[]=nothing)
        isempty(raw["errors"]) || (raw["partial_correctness"]=partialvalue(G.PROGRESS))
        raw["ambient_restored"]=precision(BigFloat)==ambient && rounding(BigFloat)==rnd && Base.MPFR.ROUNDING_MODE[]==globalrnd
        raw["loaded_paths"]=Dict(string(id)=>realpath(pathof(m)) for (id,m) in Base.loaded_modules if !isnothing(pathof(m)))
        path=joinpath(out,"raw.toml");ispath(path) && error("raw exists")
        open(path,"w") do io;TOML.print(io,raw);end
    end
    isempty(raw["errors"]) && raw["ambient_restored"] && length(raw["costs"])==12 && length(raw["micro"])==6 || error("incomplete qualification")
    println("MA-V process $index complete")
end
