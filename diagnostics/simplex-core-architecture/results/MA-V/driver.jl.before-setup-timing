serialtokens(x)=[repr(v) for v in TST.tokens(x)]
function counts(ts)
    c=Test.get_test_counts(ts)
    Dict("pass"=>c.passes+c.cumulative_passes,"fail"=>c.fails+c.cumulative_fails,"error"=>c.errors+c.cumulative_errors,"broken"=>c.broken+c.cumulative_broken)
