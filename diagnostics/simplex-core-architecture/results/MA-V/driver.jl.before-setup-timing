function context(f,scope)
    TST.context(256,RoundNearest) do
        if scope in ("absent","keys8")
            G.unrelated(f,scope=="keys8" ? 8 : 0)
        elseif scope=="equal"
            setrounding(f,BigFloat,RoundNearest)
        elseif scope in ("up","upkeys64")
            setrounding(BigFloat,RoundUp) do
                G.unrelated(f,scope=="upkeys64" ? 64 : 0)
            end
        elseif scope=="nested"
            setrounding(BigFloat,RoundUp) do
                setrounding(f,BigFloat,RoundDown)
            end
        else
            error("unknown scope")
        end
    end
end
@noinline function batch(f::F,x) where F
    for _ in 1:4; f(x.dest,x.backend,x.rhs); end
    nothing
end
metrics(t)=Dict{String,Any}("seconds"=>t.time,"bytes"=>t.bytes,"events"=>Base.gc_alloc_count(t.gcstats),"gc_seconds"=>t.gctime,"compile_seconds"=>t.compile_time,"recompile_seconds"=>t.recompile_time)
window(f,x)=metrics(@timed batch(f,x))
function costs(index,cases,records,progress,old=false)
    for (ci,c) in enumerate(cases)
        context(c.scope) do
            x=TST.bundle(c.n,c.layout); a,b=deepcopy(x),deepcopy(x)
            xs=(a,b); zeroes=(copy(a.dest),copy(b.dest))
            snapshots=[(factor=TST.tokens(y.backend.factorization.factors),ipiv=copy(y.backend.factorization.ipiv),rhs=TST.tokens(y.rhs),owners=copy(vec(y.backend.factorization.factors)),rhsowners=collect(y.rhs),destowners=copy(y.dest),desttokens=TST.tokens(y.dest)) for y in xs]
            arm=old ? OLD : P
            fs=c.direction=="forward" ? (P.reference_forward!,arm.candidate_forward!) : (P.reference_transpose!,arm.candidate_transpose!)
            ws=Any[]; expected=nothing
            row=Dict{String,Any}("id"=>c.id,"eligible"=>c.eligible,"windows"=>ws,"expected"=>String[])
            push!(records,row)
            for pair in 1:10
                order=iseven(index+ci+pair) ? (1,2) : (2,1)
                for (oi,side) in enumerate(order)
                    y=xs[side];s=snapshots[side];copyto!(y.dest,zeroes[side])
                    progress["location"]="cost/$(c.id)/$pair/$side"
                    w=window(fs[side],y)
                    merge!(w,Dict("side"=>side==1 ? "reference" : "candidate","pair"=>pair,"order"=>oi,"phase"=>pair<=3 ? "warm" : "measured","calls"=>4))
                    push!(ws,w)
                    journal_record(Dict("kind"=>"whole-metrics","location"=>progress["location"],"window"=>copy(w)))
                    output=serialtokens(y.dest);w["output"]=output
                    expected===nothing && (expected=output;row["expected"]=output)
                    F=y.backend.factorization
                    preserved=TST.tokens(F.factors)==s.factor && F.ipiv==s.ipiv && TST.tokens(y.rhs)==s.rhs && all(v===u for (v,u) in zip(F.factors,s.owners)) && all(v===u for (v,u) in zip(y.rhs,s.rhsowners)) && TST.tokens(s.destowners)==s.desttokens
                    w["preserved"]=preserved
                    journal_record(Dict("kind"=>"whole-complete","location"=>progress["location"],"window"=>copy(w)))
                    output==expected || error("window output mismatch")
                    preserved || error("window input changed")
                end
            end
        end
    end
    records
end
median7(xs) = (v=sort!(collect(xs));length(v)==7 || error("seven measured windows required");v[4])
function old_red_pass(rows)
    length(rows)==2 || return false
    all(rows) do c
        ws=filter(w->w["phase"]=="measured",c["windows"])
        all(w->w["compile_seconds"]==0 && w["recompile_seconds"]==0,ws) || return false
        any(("bytes","events")) do key
            median7(w[key] for w in ws if w["side"]=="candidate") > median7(w[key] for w in ws if w["side"]=="reference")
        end
    end
end
