ROAD.write_text(ROAD.read_text().rstrip()+'\n\n## Native pivot production commit readiness (2026-10-16)\n\n'+text.rstrip()+'\n')
checks=dict(review_accepted=True,exact_readiness_bindings=True,exact_production10=True,master_base_unchanged=True,production_unpushed=rd(D/'production-commit.json')['pushed'] is False,no_numerical_attempt=True,host_groups_sessions_closed=True,actual_diagnostic513_unchanged=True,prior_maps4=len(maps)==4,offline42=rd(D/'offline-tests.json')['all_passed'],required_selfbinding3=rd(D/'required-binding-check.json')['all_passed'])
require(all(checks.values()),'Closure checks')
files=[p for p in D.iterdir() if p.is_file()]+[S,ROAD];save(D/'closure.json',dict(all_passed=True,checks=checks,sha256={str(p.relative_to(R)):sha(p) for p in files}))
print('Readiness closure',len(checks),'PASS',len(files),'bindings')
